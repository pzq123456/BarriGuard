# deploy/ 构建上下文排除规则（context = deploy/）。
# 镜像只需 server/ water_barrier/ night_lamp/ 三个包。

# VCS / 缓存
.git
.gitignore
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行期挂载，不烘进镜像
config.yaml

# 运行产物 / 大文件（决策数据不落盘，但本机残留也别打进镜像）
evidence/
logs/
tmp/
data/
results/
output/
night_lamp/output/
*.mp4
*.npy
*.pdf

# 部署脚手架自身
Dockerfile
docker-compose.yml
.dockerignore
*.md
